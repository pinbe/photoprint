/* photoprint <dtml-with base_properties> */

@font-face {
  font-family: sriracha-regular;
  src: url("&dtml-portal_url;/Sriracha-Regular.ttf");
}

#print_options_editor > tr > td {
  vertical-align: top;
}

#print_options_editor .TwoColumnForm th::after {
  content: " :";
}

#print_options_editor table.TwoColumnForm
{
  border: 1px solid &dtml-highLightColor;;
  width: 100%;
}

#print_options_editor table.TwoColumnForm th {
  white-space: nowrap;
}

#print_options_editor div.buttons {
  text-align: center;
}

#print_options_editor textarea:focus {
  outline: none;
}

#print_options_editor i.btn.edit::before {
  content: "\f044"; /* fas fa-edit */
}

#print_options_editor i.btn.validate::before {
  content: "\f00c"; /* fas fa-check */
}

#print_options_editor *:invalid,
#print_options_editor *.invalid,
#cart-form *:invalid
{
  border-color: #d20000;
}

#print_options_editor ul {
  list-style: none;
}

#print_options_editor textarea {
  width: 100%;
  height: 6em;
}


#print_options_editor .cols-headers h2 {
  text-align: center;
}

#print_options_editor svg {
  /*border: 1px dashed #b4098c;*/
}

#print_options_editor .bottom-buttons > div {
  text-align: center;
}

#print_options_editor path.outlet,
#print_options_editor path.inlet
{
  fill: &dtml-highLightColor;;
  cursor: pointer;
}

#print_options_editor path.link {
  fill: none;
  stroke: &dtml-highLightColor;;
  stroke-width: 2px;
}

#print_options_editor path.link.over {
  stroke-width: 8px;
  cursor: not-allowed;
}

#print_options_editor div.history-bar {
  display: flex;
  justify-content: flex-end;
}

#print_options_editor div.history-bar > a {
  padding: 0 0.5em;
}

#print_options_editor div.history-bar i {
  font-size: 200%;
}

#sale-options .section-option-label {
  border: 1px solid #686868;
  padding: 0.2em 1em;
  margin: 4px 0;
}

#sale-options .choices {
  padding: 0 0 0 1em;
}

#sale-options .choices > div {
  margin: 2px 0;
}

#sale-options .choices .description {
  padding: 0 0 0 16px;
  font-style: italic;
}

#sale-options .total-price-wrapper {
  margin-top: 1em;
}

#sale-options .total-price-wrapper .total {
  padding-left: 0.5em;
}

#sale-options .cart-btn-wrapper {
  margin-top: 10px;
  text-align: center;
}

/* cart */

#cart-form .btn.del {
  font-size: 15px;
}

tbody.total th {
}

tbody.total td {
  font-weight:bold;
  font-size:110%;
}

td.num,
th.num {
  text-align:right;
  padding-right:0.5em ;
  white-space: nowrap;
}

td.num input[type="text"] {
  text-align: right;
}

.sell_steps_bar {
  margin-top: 10px;
  height: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sell_steps_bar ul {
  display: flex;
}

.sell_steps_bar ul li {
  padding: 0 10px;
  margin-right: 20px;
	display: flex;
  flex-direction: column;
  justify-content: center;
  height: 30px;
	position: relative;
	font-weight:bold;
	color:&dtml-fontColor;;
  border: 1px solid &dtml-tabsBorderColor;;
}

.sell_steps_bar ul li.done {
	background:&dtml-tabsBorderColor;;
}

.sell_steps_bar ul li:after {
	left: 100%;
	border: solid transparent;
	content: " ";
	height: 0;
	width: 0;
	position: absolute;
	pointer-events: none;

	border-left-color:&dtml-tabsBorderColor;;
	border-width: 16px;
}

.sell_steps_bar ul li.active:after {
	border-left-color:&dtml-tabsBorderColor;;
}

/* Order page */

#order-page .order-wf-state {
  font-family: sriracha-regular;
  text-transform: uppercase;
  font-size: 30px;
  display: inline-block;
  transform: rotate(-7deg);
  top: -15px;
  left: 20px;
  color: #e63600;
}

#order-page .order-num {
  font-weight: bold;
}

#order-page .invoice-infos {
  display: flex;
  margin-bottom: 20px;
}
#order-page .invoice-infos > div {
  margin-right: 20px;
}

#order-page table.listing {
  border-collapse: collapse;
}

/* </dtml-with> */
